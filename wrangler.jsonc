{
  // stl-grow: personal improvement tracker at https://stluker.com/grow
  // Deploys from GitHub Actions on push to master (test -> D1 migrate -> deploy).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stl-grow",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Vault §7 rule 6: declare workers_dev explicitly. No *.workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,

  // ROUTES ARE MANAGED IN THE DASHBOARD, NOT HERE (Nov 8, 2026).
  // Wrangler attaches routes with PUT /accounts/:id/workers/scripts/stl-grow/routes,
  // which a user API token under Cloudflare's granular Workers permissions is
  // refused on; with no `routes` key, `wrangler deploy` never touches routes.
  // Live routes (Workers & Pages > stl-grow > Settings > Domains & Routes):
  //   stluker.com/grow        stluker.com/grow/*
  //   www.stluker.com/grow    www.stluker.com/grow/*
  // Exact patterns so /growth etc. never match. Zone routes take precedence over
  // the `stluker` Worker's custom domain for these paths only. The CI smoke test
  // fails if /grow/health is not served by this Worker.

  // Every request goes through the Worker first so the auth gate also covers
  // static files (Vault §7 rule 6: assets shadow the Worker unless this is set).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grow-db",
      "database_id": "919cdb61-9b62-44d3-8186-cbc196bacefc",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }

  // Secrets (set once with `npx wrangler secret put <NAME>`; never in this file):
  //   ACCESS_TEAM_DOMAIN  e.g. <team>.cloudflareaccess.com
  //   ACCESS_AUD          the Access application's Audience (AUD) tag
  //   ALLOWED_EMAILS      comma-separated emails allowed in
  // Missing any of them => every non-public request gets 503 (fails closed).
}
